# ─────────────────────────────────────────────────────────────
# SynaptiQ — variables d'environnement (copier en .env)
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ─── Base de données PostgreSQL ───
# En local (hors Docker) : port hôte 5435 exposé par docker-compose.
DATABASE_URL=postgresql://synaptiq:synaptiq_password@127.0.0.1:5435/synaptiq_db
# En conteneur, docker-compose surcharge automatiquement avec :
#   postgresql://synaptiq:synaptiq_password@postgres:5432/synaptiq_db

# ─── Cache & file d'événements Redis ───
REDIS_URL=redis://127.0.0.1:6399/0
# En conteneur : redis://redis:6379/0 (surchargé par docker-compose)

# ─── Embeddings (Phase 1) ───
# Fournisseur : lmstudio (défaut) | openrouter | openai | mock (tests uniquement)
EMBEDDING_PROVIDER=lmstudio
# Endpoint OpenAI-compatible de LM Studio ou OpenRouter (https://openrouter.ai/api/v1).
#   LM Studio local   : http://localhost:1234/v1
#   OpenRouter        : https://openrouter.ai/api/v1
EMBEDDING_BASE_URL=http://localhost:1234/v1
# Identifiant du modèle chargé :
#   LM Studio local   : text-embedding-paraphrase-multilingual-minilm-l12-v2.gguf (384 dim)
#   OpenRouter        : openai/text-embedding-3-small (1536 dim) ou baai/bge-m3 (1024 dim)
EMBEDDING_MODEL=text-embedding-paraphrase-multilingual-minilm-l12-v2.gguf
# Dimension du vecteur — DOIT correspondre à la colonne VECTOR(n) en base (384 par défaut).
EMBEDDING_DIM=384
# Clé API pour OpenRouter (ou OPENROUTER_API_KEY) — LM Studio l'ignore.
EMBEDDING_API_KEY=lm-studio

# ─── Extraction LLM (worker de consolidation) ───
# ⚠️ CE RÉGLAGE DÉCIDE SI TU VOIS RÉELLEMENT Q-EM À L'ŒUVRE.
# Un LLM instruct classe chaque événement en souvenir DURABLE (semantic/preference,
# semantic/fact, procedural/*). Ce sont ces types qui déclenchent l'intrication
# automatique (cf. QEM_ENTANGLE_TYPES) et donc le graphe `entangled_with` que la
# propagation multi-hop de /context/build exploite.
# Sans LLM, l'extraction retombe sur des heuristiques regex qui produisent surtout
# episodic/interaction : le graphe reste vide et Q-EM dégénère en simple top-k vectoriel.
#
# Fournisseur : lmstudio (local, défaut) | openrouter/openai/nvidia (distant) | mock (heuristique regex)
LLM_PROVIDER=lmstudio
# Charger un modèle INSTRUCT dans LM Studio (en plus du modèle d'embedding) et coller ici
# son id exact — visible via  curl http://localhost:1234/v1/models .
LLM_MODEL=qwen2.5-7b-instruct
# Endpoint OpenAI-compatible (valeur utilisée hors conteneur).
LLM_BASE_URL=http://localhost:1234/v1
# Valeur utilisée PAR LE WORKER EN CONTENEUR : 'localhost' y désignerait le conteneur
# lui-même, d'où la réécriture vers l'hôte. À changer uniquement si l'extraction passe
# par un endpoint distant (ex: LLM_BASE_URL_DOCKER=https://openrouter.ai/api/v1).
LLM_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
# Inutile pour un endpoint local (détecté automatiquement) ; requis pour un provider distant.
LLM_API_KEY=
#
# Si l'endpoint est injoignable ou le modèle absent, le worker retombe silencieusement
# sur les heuristiques regex (aucun crash), mais tu perds la classification riche.
#
# ── Alternative distante (OpenRouter) ──
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=meta-llama/llama-3-8b-instruct:free
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...

# ─── Sécurité ───
# Tenant de CETTE instance (SynaptiQ est auto-hébergé : un déploiement = un tenant).
# Injecté côté serveur ; jamais transmis par l'agent. La séparation par agent se
# fait via `agent_id` dans les appels. Ne changer que si des données existent déjà
# sous un autre identifiant en base.
SYNAPTIQ_TENANT=default
#
# Exiger une clé API (header Bearer) sur chaque requête.
#   false (défaut) = instance de confiance (localhost / réseau interne).
#   IMPORTANT : si l'API est exposée sur Internet, mettre true et créer une clé
#   (scripts/create_api_key.py), sinon l'instance est ouverte en lecture/écriture.
SYNAPTIQ_AUTH_REQUIRED=true
#
# Origines CORS pour un front NAVIGATEUR (séparées par des virgules).
#   Vide (défaut) = aucune origine navigateur (API appelée serveur-à-serveur : OK).
#   Lister les origines explicites (ex: https://app.exemple.com) si front web.
#   '*' est toléré mais désactive automatiquement les credentials (non conforme).
CORS_ORIGINS=
# Rate limiting global (format slowapi, ex: 120/minute, 5/second).
RATE_LIMIT=120/minute
#
# Durée de mise en cache de la résolution d'une clé API, en secondes.
# Sans cache, CHAQUE requête faisait un SELECT + un UPDATE + un COMMIT sur `api_keys` :
# toutes les requêtes d'une même clé écrivaient sur la même ligne (verrou disputé, WAL
# inutile, latence plancher doublée).
# ⚠️ Compromis assumé : une clé révoquée reste acceptée au maximum ce délai.
#    Mettre 0 pour une révocation immédiate (et retrouver un accès base par requête).
AUTH_CACHE_TTL=60
# Nombre maximal d'entrées de cache (garde-fou contre un flot de clés arbitraires).
AUTH_CACHE_MAX=1024
# Pool de connexions PostgreSQL (API).
DB_POOL_MIN=1
DB_POOL_MAX=10
# Pool de connexions PostgreSQL (worker de consolidation).
WORKER_DB_POOL_MIN=1
WORKER_DB_POOL_MAX=4
# Fiabilité worker : plafond de re-livraisons avant DLQ ; délai d'inactivité avant reclaim ;
# intervalle max de reclaim même sous charge continue (le retry avance toujours).
EVENT_MAX_DELIVERIES=5
EVENT_IDLE_RECLAIM_MS=30000
EVENT_RECLAIM_INTERVAL_MS=15000

# ─── Recherche hybride (vectoriel + plein texte) ───
# La similarité vectorielle ramène le « sémantiquement proche » ; elle manque en revanche
# les correspondances LITTÉRALES (noms propres, dates, identifiants, références techniques).
# La recherche plein texte PostgreSQL comble ce trou, et les deux classements sont fusionnés
# par RRF — une fusion par RANG, insensible au fait que cosinus et ts_rank ne vivent pas sur
# la même échelle. Mettre false pour revenir au classement purement vectoriel (utile pour
# mesurer l'apport de l'hybride).
RETRIEVAL_HYBRID=true
# Candidats ramenés PAR CHEMIN avant fusion. Monter améliore le rappel, au prix du temps
# de requête et du travail de filtrage en aval.
RETRIEVAL_CANDIDATES=50
# Amortissement de la fusion RRF : petit k = les tout premiers rangs dominent nettement.
# 60 est la valeur de référence de la publication d'origine.
RRF_K=60
# Confiance relative accordée à chaque chemin. Monter RRF_WEIGHT_FTS favorise les
# correspondances exactes (utile sur un corpus riche en identifiants ou en noms propres).
RRF_WEIGHT_VECTOR=1.0
RRF_WEIGHT_FTS=1.0

# ─── Réglages moteur Q-EM (tous ajustables sans redéploiement) ───
# Seuil de PRÉ-FILTRAGE des préférences candidates à une contradiction (0..1).
# ⚠️ Ce seuil ne décide plus d'archiver : il borne seulement le nombre de paires soumises
# au juge (cf. CONTRADICTION_JUDGE). Avant le 29/07, il archivait directement, ce qui
# supprimait des préférences simplement PROCHES (« mails courts » / « mails en français »).
CONTRADICTION_SIM_THRESHOLD=0.8
# Qui décide qu'une nouvelle préférence en contredit une ancienne :
#   auto (défaut) = juge LLM si un LLM est configuré (LLM_PROVIDER/LLM_BASE_URL), sinon aucun
#   llm           = force le juge LLM
#   off           = aucun archivage automatique ; les préférences proches coexistent
# Sans juge, rien n'est jamais archivé : la déduplication se dégrade, la donnée ne se perd pas.
CONTRADICTION_JUDGE=auto
# Seuil cosinus d'intrication automatique entre deux mémoires (worker).
QEM_ENTANGLE_THRESHOLD=0.7
# Types de mémoire éligibles à l'intrication automatique (virgules). Ce sont eux qui
# construisent le graphe exploité par la propagation multi-hop. `episodic` est exclu par
# défaut : les épisodes bruts sont nombreux et peu discriminants, les intriquer densifie
# le graphe sans gain de pertinence.
QEM_ENTANGLE_TYPES=procedural,semantic
# Amortissement de la propagation d'activation le long des liens intriqués (0..1).
QEM_ENTANGLE_DAMPING=0.5
# Nombre max de sauts de propagation (spreading activation). 1 = mono-saut ; 2 = défaut.
QEM_ENTANGLE_MAX_HOPS=2
# Seuil cosinus au-delà duquel un candidat redondant est filtré (build_context).
QEM_REDUNDANCY_THRESHOLD=0.75
# ─── Sécurité & Authentification ───
# Exige une clé API valide (header Authorization: Bearer <clé>) sur chaque requête API.
SYNAPTIQ_AUTH_REQUIRED=true
# Tenant par défaut de l'instance (déploiement auto-hébergé mono-tenant).
SYNAPTIQ_TENANT=default

# ─── SDK / MCP ───
SYNAPTIQ_API_URL=http://127.0.0.1:8000
# Clé API SynaptiQ utilisée par le SDK et le serveur MCP (créée via scripts/create_api_key.py).
SYNAPTIQ_API_KEY=
# Identité mémoire de l'agent servi par le serveur MCP. **OBLIGATOIRE** : le serveur refuse
# de démarrer sans elle.
#
# Fixée par la CONFIGURATION, pas par l'appelant : jusqu'au 29/07, `agent_id` était un
# paramètre d'outil MCP, donc une valeur que le LLM choisissait lui-même — il suffisait
# d'une autre chaîne pour lire la mémoire d'un autre agent.
#
# ⚠️ Elle n'a volontairement AUCUN défaut. Elle valait `qwen_code_agent`, ce qui a provoqué
# une panne en production le 29/07 : le serveur lisait une partition vide et répondait
# « aucun souvenir trouvé », sans erreur. Pour un moteur de mémoire, ce symptôme est
# indiscernable d'une mémoire réellement vide. Un démarrage refusé vaut mieux.
#
# Retrouver l'identifiant de souvenirs déjà écrits :
#   SELECT agent_id, count(*) FROM memories GROUP BY 1;
# Pour verrouiller aussi côté serveur : `create_api_key.py --agents <cet_identifiant>`.
SYNAPTIQ_AGENT_ID=
#
# Le serveur MCP démarre l'API HTTP si elle ne répond pas (pratique en poste de travail).
# Mettre false en conteneur, où l'API est un service à part.
SYNAPTIQ_AUTOSTART_API=true

# ─── Serveur MCP ───
# Transport : stdio (défaut, pour Claude Desktop / Cursor) | sse | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8765
